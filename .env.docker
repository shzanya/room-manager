# ── Room Manager — Docker Production ──────────────────────────────
# Copy to .env and fill in your values

# ── Discord ───────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_DB=room_manager
POSTGRES_USER=roommanager
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Bot ───────────────────────────────────────────────────────────
CLUSTER_NAME=Frankfurt
LOG_LEVEL=info
METRICS_PORT=9090
BOT_PORT=9090
BOT_REPLICAS=1

# ── Nginx ─────────────────────────────────────────────────────────
NGINX_PORT=80
