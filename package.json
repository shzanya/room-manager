{
  "name": "room-manager",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "start": "bun run --cwd apps/bot start",
    "setup:workspaces": "bun scripts/setup-workspaces.ts",
    "setup:dependencies": "bun scripts/setup-dependencies.ts",
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "biome lint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:staged": "biome check --write --staged --no-errors-on-unmatched",
    "ci:biome": "biome ci --reporter=github --reporter=default ."
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/bun": "latest",
    "@types/node": "latest",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.0.0",
    "turbo": "latest",
    "typescript": "latest"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.23.15",
    "zod": "^4.4.3"
  }
}
